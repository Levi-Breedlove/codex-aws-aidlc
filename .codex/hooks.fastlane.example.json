{
  "description": "Optional post-Gate-B Fastlane defense-in-depth guardrails. Enable only after a current Gate B; stale gates fail closed.",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "",
            "commandWindows": "",
            "timeout": 30,
            "statusMessage": "Loading Fastlane state"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "^(Bash|apply_patch|use_aws|aws___.*|mcp__.*)$",
        "hooks": [
          {
            "type": "command",
            "command": "",
            "commandWindows": "",
            "timeout": 30,
            "statusMessage": "Checking Fastlane boundary"
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "matcher": "^(Bash|apply_patch|use_aws|aws___.*|mcp__.*)$",
        "hooks": [
          {
            "type": "command",
            "command": "",
            "commandWindows": "",
            "timeout": 30,
            "statusMessage": "Checking Fastlane approval boundary"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "^(Bash|apply_patch|use_aws|aws___.*|mcp__.*)$",
        "hooks": [
          {
            "type": "command",
            "command": "",
            "commandWindows": "",
            "timeout": 60,
            "statusMessage": "Running bounded Fastlane validation"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "",
            "commandWindows": "",
            "timeout": 30,
            "statusMessage": "Checking Fastlane continuation"
          }
        ]
      }
    ]
  }
}
